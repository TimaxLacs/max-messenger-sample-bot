# MAX: business.max.ru → Чат-боты → Интеграция → Получить токен
BOT_TOKEN=

# Общий секрет между bot и orchestrator (одинаковый в compose для обоих сервисов).
# Если пусто — бот возвращает исходное фото без вызова оркестратора; в проде держите токен заполненным.
INTERNAL_TOKEN=

# Локально без Docker можно указать http://localhost:8000 если оркестратор запущен отдельно
# В docker-compose задаётся автоматически (см. docker-compose.yml)
ORCHESTRATOR_URL=

# Если MAX не отдаёт картинку по URL без токена — поставь 1
MAX_IMAGE_USE_BOT_AUTH=0

# Опционально: внешняя генерация POST multipart поле file, form preset=may9
AI_TRANSFORM_URL=

# только webhook-режим (src/webhook.mjs)
WEBHOOK_SECRET=
PORT=8080
WEBHOOK_PATH=/webhook
