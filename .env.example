# Токен: business.max.ru → Чат-боты → Интеграция → Получить токен
# Скопируй в .env: cp .env.example .env и подставь значение в .env (не сюда)
BOT_TOKEN=

# Только для webhook-режима: проверка заголовка X-Max-Bot-Api-Secret (рекомендуется)
WEBHOOK_SECRET=

# Только для webhook.mjs
PORT=8080
WEBHOOK_PATH=/webhook
