# Ветка: photo-change-min — минимальный бот + памятная открытка (9 Мая), общий оркестратор.

# Токены ботов (разные у каждого инстанса на Long Polling).
BOT_TOKEN_MIN=
BOT_TOKEN_VETERAN=

# Секрет между ботами и оркестратором. Пусто — эхо без оркестратора.
INTERNAL_TOKEN=

# Lukoshko / внешняя генерация (см. docker-compose у сервиса orchestrator).
LUKOSHKO_TOKEN=
LUKOSHKO_BASE_URL=https://lukoshko.ilovlya.ru

# Режим локального запуска (без Docker для одного процесса): 1 — минимальный, 3 — открытка 9 Мая.
BOT_MODE=1

# Локально, если оркестратор не в compose: http://127.0.0.1:8000
ORCHESTRATOR_URL=

# Если MAX не отдаёт картинку по URL без токена бота — поставь 1.
MAX_IMAGE_USE_BOT_AUTH=0

# Опционально: legacy POST multipart к AI (preset=may9).
AI_TRANSFORM_URL=

# Webhook MAX (только src/webhook.mjs).
WEBHOOK_SECRET=
PORT=8080
WEBHOOK_PATH=/webhook
